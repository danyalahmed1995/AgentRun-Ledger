{
  "name": "agentrun-ledger",
  "version": "0.1.0",
  "description": "Local session receipts for AI coding agents.",
  "type": "module",
  "bin": {
    "agentrun": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "agentrun": "tsx src/cli/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && vite build --config vite.config.ts",
    "test": "vitest run --reporter=default",
    "test:agent": "vitest run --reporter=dot",
    "dashboard": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "commander": "^14.0.2",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
